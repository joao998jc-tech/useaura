    {
      "parameters": {
        "jsCode": "// ANTI-REUSO de transacao (defense-in-depth): se paid_tx/<transaction_nsu> ja existe com\n// order_nsu DIFERENTE do atual, a mesma transacao esta sendo reaproveitada p/ outro pedido.\nconst resp = $input.first().json;\nconst wh = $('Checar Idempotencia').first().json.wh;\nconst status = resp.statusCode;\nconst doc = resp.body;\nlet reuse = false;\nif (status === 200 && doc && doc.fields && doc.fields.order_nsu && typeof doc.fields.order_nsu.stringValue === 'string') {\n  if (String(doc.fields.order_nsu.stringValue) !== String(wh.order_nsu)) reuse = true;\n}\nreturn [{ json: { reuse, wh } }];"
