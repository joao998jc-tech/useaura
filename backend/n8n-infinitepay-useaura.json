        -1120,
        40
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://firestore.googleapis.com/v1/projects/useaura-34065/databases/(default)/documents/orders/{{ $('Webhook Criar Link').first().json.body.orderId }}?updateMask.fieldPaths=frete",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { fields: { frete: { doubleValue: $('Extrair Frete SF (A)').first().json.freteCobradoReais } } } }}",
        "options": {}
      },
      "id": "a1f-patch-orders-frete",
      "name": "PATCH orders.frete (A)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -960,
        40
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput",
      "credentials": {
        "googleApi": {
          "id": "REPLACE_FIREBASE_SA_CRED",
          "name": "USEAURA Firebase Service Account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// FLUXO A - preco AUTORITATIVO no servidor. O browser envia {id, quantity, description} SEM price.\n// Fonte de verdade = catalogo da dona em config/store (campo payload = JSON.stringify({produtos:[...]})).\n// PRECO UNICO: Pix e cartao usam produto.preco do catalogo (sem desconto Pix). Centavos = Math.round(preco*100).\nconst body = $('Webhook Criar Link').first().json.body || $('Webhook Criar Link').first().json;\nconst items = body.items;\n// FRETE server-side (mesma regra do site: gratis por prefixo de CEP + valor fixo fora). Nunca confia em frete do browser.\nfunction freteCentavos(fc, cepRaw){ fc = fc || {}; const vf = Number(fc.valorFora); if (!fc.configurado || !(vf >= 0)) return 0; const d = String(cepRaw==null?'':cepRaw).replace(/\\D/g,''); if (d.length !== 8) return Math.round(vf*100); const prefs = Array.isArray(fc.gratisPrefixos) ? fc.gratisPrefixos : []; for (const pp of prefs){ const p = String(pp==null?'':pp).replace(/\\D/g,''); if (p && d.indexOf(p)===0) return 0; } return Math.round(vf*100); }\nconst pagamento = body.pagamento === 'pix' ? 'pix' : 'cartao'; // default cartao se ausente\nconst errors = [];\n// --- Catalogo (fail-safe: sem catalogo => 400, nao cria link) ---\nconst catResp = $('Ler Catalogo Firestore').first().json;\nlet produtos = null;\nlet store = null;\nif (catResp && catResp.statusCode === 200 && catResp.body && catResp.body.fields && catResp.body.fields.payload && typeof catResp.body.fields.payload.stringValue === 'string') {\n  try { store = JSON.parse(catResp.body.fields.payload.stringValue); produtos = store && store.produtos; } catch (e) { produtos = null; }\n}\nif (!Array.isArray(produtos) || produtos.length === 0) {\n  return [{ json: { valid: false, error: 'catalogo indisponivel' } }];\n}\nconst freteCfg = (store && store.frete) || {};\nconst mapa = {};\nfor (const p of produtos) mapa[String(p.id)] = p;\n// --- Validacao dos itens contra o catalogo ---\nif (!Array.isArray(items) || items.length === 0) errors.push('items vazio');\nif (!body.orderId) errors.push('orderId ausente');\nconst outItems = [];\nif (Array.isArray(items)) {\n  for (const it of items) {\n    if (!Number.isInteger(it.quantity) || it.quantity <= 0) { errors.push('quantity invalido'); continue; }\n    const prod = mapa[String(it.id)];\n    if (!prod) { errors.push('produto desconhecido: ' + it.id); continue; }\n    if (prod.esgotado === true) { errors.push('produto esgotado: ' + it.id); continue; }\n    const preco = Number(prod.preco);\n    if (!(preco > 0)) { errors.push('preco invalido no catalogo: ' + it.id); continue; }\n    // basis por forma de pagamento (mesma logica do pixOf do site)\n    let basis;\n    if (pagamento === 'pix') {\n      basis = preco; // PRECO UNICO: Pix e cartao pagam o mesmo (checkout InfinitePay e multi-metodo)\n    } else {\n      basis = preco;\n    }\n    const price = Math.round(basis * 100); // ignora qualquer price vindo do browser\n    outItems.push({ quantity: it.quantity, price, description: String(it.description || prod.nome || it.id) });\n  }\n}\nif (errors.length) {\n  return [{ json: { valid: false, error: errors.join('; ') } }];\n}\n// FRETE recomputado do CEP do pedido (antifraude): adiciona 1 item 'Frete' se > 0.\nconst cepA = (body.address && body.address.cep) || '';\n// R1: SF ativo + frete_servico presente => frete AUTORITATIVO do SuperFrete (no no 'Extrair Frete SF (A)').\n// SF-OFF (sem frete_servico) OU falha na cotacao SF => freteCentavos(prefixo), IDENTICO a hoje.\nconst _sf = store && store.frete && store.frete.superfrete;\nlet freteC;\nconst _fretePrefixo = freteCentavos(freteCfg, cepA);\nif (_fretePrefixo === 0) {\n  // Regiao gratis por prefixo = PRIORIDADE ABSOLUTA sobre o SuperFrete (Opcao A). Nao cota nem cobra SF.\n  freteC = 0;\n} else if (body.frete_servico && _sf && _sf.ativo) {\n  const _ex = $('Extrair Frete SF (A)').first().json;\n  freteC = (_ex && _ex.sfOk) ? (Number(_ex.sfFreteCentavos) || 0) : _fretePrefixo;\n} else {\n  freteC = _fretePrefixo;\n}\nif (freteC > 0) outItems.push({ quantity: 1, price: freteC, description: 'Frete' });\nconst payload = {\n  handle: $env.INFINITEPAY_HANDLE,\n  order_nsu: String(body.orderId),\n  items: outItems,\n  redirect_url: body.redirect_url,\n  webhook_url: $env.INFINITEPAY_WEBHOOK_URL,\n};\nif (body.customer) payload.customer = body.customer;\nif (body.address) payload.address = body.address;\nreturn [{ json: { valid: true, payload } }];"
      },
