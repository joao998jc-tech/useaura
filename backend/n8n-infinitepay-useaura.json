        "jsCode": "// IDEMPOTENCIA: se payments/<order_nsu> ja esta 'pago', nao reprocessa.\nconst resp = $input.first().json;\nconst status = resp.statusCode;\nconst doc = resp.body;\nlet alreadyPaid = false;\nif (status === 200 && doc && doc.fields && doc.fields.status && doc.fields.status.stringValue === 'pago') {\n  alreadyPaid = true;\n}\nconst wh = $('Webhook Callback').first().json.body;\nreturn [{ json: { alreadyPaid, wh } }];"
