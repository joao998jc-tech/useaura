    {
      "parameters": {
        "jsCode": "const catResp = $('Ler Catalogo Firestore').first().json;\nlet store = null;\nif (catResp && catResp.statusCode === 200 && catResp.body && catResp.body.fields && catResp.body.fields.payload && typeof catResp.body.fields.payload.stringValue === 'string') {\n  try { store = JSON.parse(catResp.body.fields.payload.stringValue); } catch (e) { store = null; }\n}\nconst freteCfg = (store && store.frete) || {};\nfunction freteCentavos(fc, cepRaw){ fc = fc || {}; const vf = Number(fc.valorFora); if (!fc.configurado || !(vf >= 0)) return 0; const d = String(cepRaw==null?'':cepRaw).replace(/\\D/g,''); if (d.length !== 8) return Math.round(vf*100); const prefs = Array.isArray(fc.gratisPrefixos) ? fc.gratisPrefixos : []; for (const pp of prefs){ const p = String(pp==null?'':pp).replace(/\\D/g,''); if (p && d.indexOf(p)===0) return 0; } return Math.round(vf*100); }\nconst body = $('Webhook Criar Link').first().json.body || {};\nconst cepA = (body.address && body.address.cep) || '';\nconst servId = parseInt(body.frete_servico, 10);\nlet resp = $('Cotar SF (A)').first().json;\n// resposta pode vir como {ok,servicos:[...]} ou array\nconst servicos = Array.isArray(resp) ? resp : (resp && resp.servicos) || [];\nlet match = servicos.find(s => parseInt(s.id,10) === servId && !s.has_error);\nif (match && Number(match.price) >= 0) {\n  const reais = Number(match.price);\n  return [{ json: { sfOk: true, sfFreteReais: reais, sfFreteCentavos: Math.round(reais*100), freteCobradoReais: reais, servId } }];\n}\n// falha SF => Fluxo A cobra frete fixo (freteCentavos). Grava esse valor efetivo em orders.frete.\nconst fallbackCent = freteCentavos(freteCfg, cepA);\nreturn [{ json: { sfOk: false, sfFreteCentavos: fallbackCent, freteCobradoReais: fallbackCent / 100, servId } }];"
      },
      "id": "a1e-extrair-frete-sf",
      "name": "Extrair Frete SF (A)",
      "type": "n8n-nodes-base.code",
