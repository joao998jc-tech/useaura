      "id": "b6e-resp-reconc-falha",
      "name": "Responder 400 Reconcile Falhou",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        -500,
        620
      ]
    },
    {
      "parameters": {
        "jsCode": "// REGRA DURA: reconcilia contra o TOTAL AUTORITATIVO do pedido, NAO contra wh.amount.\n// total = soma sobre order.fields.itens do basis por forma de pagamento *100*qtd.\n// So 'pago' se success && paid && paid_amount === total.\nconst check = $input.first().json;\nconst wh = $('Checar Idempotencia').first().json.wh;\n// helper p/ ler valor escalar tipado do Firestore REST\nfunction fsVal(v) { if (v == null) return undefined; if ('stringValue' in v) return v.stringValue; if ('integerValue' in v) return v.integerValue; if ('doubleValue' in v) return v.doubleValue; if ('booleanValue' in v) return v.booleanValue; return undefined; }\n// FRETE server-side (mesma regra do site: gratis por prefixo de CEP + valor fixo fora). Nunca confia em frete do browser.\nfunction freteCentavos(fc, cepRaw){ fc = fc || {}; const vf = Number(fc.valorFora); if (!fc.configurado || !(vf >= 0)) return 0; const d = String(cepRaw==null?'':cepRaw).replace(/\\D/g,''); if (d.length !== 8) return Math.round(vf*100); const prefs = Array.isArray(fc.gratisPrefixos) ? fc.gratisPrefixos : []; for (const pp of prefs){ const p = String(pp==null?'':pp).replace(/\\D/g,''); if (p && d.indexOf(p)===0) return 0; } return Math.round(vf*100); }\n// --- Catalogo autoritativo ---\nconst catResp = $('Ler Catalogo Firestore (B)').first().json;\nlet produtos = null;\nlet store = null;\nif (catResp && catResp.statusCode === 200 && catResp.body && catResp.body.fields && catResp.body.fields.payload && typeof catResp.body.fields.payload.stringValue === 'string') {\n  try { store = JSON.parse(catResp.body.fields.payload.stringValue); produtos = store && store.produtos; } catch (e) { produtos = null; }\n}\nconst mapa = {};\nif (Array.isArray(produtos)) for (const p of produtos) mapa[String(p.id)] = p;\nconst freteCfg = (store && store.frete) || {};\n// --- Itens do pedido (orders/{order_nsu}) ---\nconst orderResp = $('Ler Order Firestore').first().json;\nconst fields = orderResp && orderResp.body && orderResp.body.fields;\n// forma de pagamento gravada no pedido (default cartao) -> mesmo basis do Fluxo A\nconst pagamento = (fields && fields.pagamento && fields.pagamento.stringValue === 'pix') ? 'pix' : 'cartao';\nconst itensArr = (fields && fields.itens && fields.itens.arrayValue && Array.isArray(fields.itens.arrayValue.values)) ? fields.itens.arrayValue.values : [];\nlet totalAutoritativo = 0;\nlet calcOk = Array.isArray(produtos) && produtos.length > 0 && itensArr.length > 0;\nif (calcOk) {\n  for (const el of itensArr) {\n    const f = el && el.mapValue && el.mapValue.fields;\n    if (!f) { calcOk = false; break; }\n    const id = String(fsVal(f.id));\n    const qtd = parseInt(fsVal(f.qtd), 10);\n    const prod = mapa[id];\n    if (!prod || !Number.isInteger(qtd) || qtd <= 0) { calcOk = false; break; }\n    const preco = Number(prod.preco);\n    if (!(preco > 0)) { calcOk = false; break; }\n    // basis por forma de pagamento (mesma logica do pixOf do site / Fluxo A)\n    let basis;\n    if (pagamento === 'pix') {\n      basis = preco; // PRECO UNICO: Pix e cartao pagam o mesmo (checkout InfinitePay e multi-metodo)\n    } else {\n      basis = preco;\n    }\n    totalAutoritativo += Math.round(basis * 100) * qtd;\n  }\n}\n// FRETE do pedido recomputado do CEP (mesma regra do Fluxo A) — soma ao total autoritativo\nif (calcOk) {\n  const cepF = (fields && fields.entrega && fields.entrega.mapValue && fields.entrega.mapValue.fields && fields.entrega.mapValue.fields.cep) ? fsVal(fields.entrega.mapValue.fields.cep) : '';\n  const _fretePrefixo = freteCentavos(freteCfg, cepF);\n  const frServ = fields && fields.frete_servico ? fsVal(fields.frete_servico) : undefined;\n  if (_fretePrefixo === 0) {\n    // Regiao gratis por prefixo = PRIORIDADE ABSOLUTA sobre o SuperFrete (espelho do Fluxo A). Nao soma frete.\n    totalAutoritativo += 0;\n  } else if (frServ != null && frServ !== '') {\n    // R1: pedido SF => frete COBRADO gravado pelo Fluxo A em orders.frete (reais) -> centavos\n    const freteReais = Number(fsVal(fields.frete)) || 0;\n    totalAutoritativo += Math.round(freteReais * 100);\n  } else {\n    // SF-OFF: freteCentavos(prefixo), IDENTICO a hoje\n    totalAutoritativo += _fretePrefixo;\n  }\n}\nconst reconciled = !!(calcOk && check && check.success === true && check.paid === true && Number(check.amount) === totalAutoritativo && Number(check.paid_amount) >= totalAutoritativo); // amount = valor do pedido (fecha subpagamento); paid_amount >= total aceita a taxa do cartao (repasse) que o cliente paga a mais\nreturn [{ json: { reconciled, wh, check, totalAutoritativo } }];"
      },
