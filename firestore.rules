rules_version = '2';

// USE AURA — regras de segurança do Firestore (produção).
// Dona = conta autenticada por e-mail em Firebase Auth. Se trocar o e-mail,
// troque também em assets/js/config.js (ownerEmail).
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      // HARDENING OPCIONAL (go-live): some `&& request.auth.token.email_verified == true`
      // — exige que a dona verifique o e-mail. Alternativa (recomendada p/ evitar
      // travar a dona): desativar cadastro público no console (a conta da dona é a
      // única) — ver checklist. Se trocar o e-mail, troque em config.js (ownerEmail).
      return request.auth != null
        && request.auth.token.email == 'useaura@gmail.com';
    }

    // Loja: produtos, categorias, banner, promo, páginas (1 doc config/store).
    // Leitura PÚBLICA (o cliente precisa ver a loja); ESCRITA só da dona.
    match /config/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Pedidos: o comprador (anônimo) só pode CRIAR; ler/editar/excluir é só da dona.
    // create validado p/ limitar abuso: status inicial 'novo', total numérico,
    // e limites de tamanho no documento e na lista de itens.
    match /orders/{orderId} {
      allow read, update, delete: if isOwner();
      allow create: if request.resource.data.status == 'novo'
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.total <= 100000
        && request.resource.data.createdAt is number
        && request.resource.data.cliente is map
        && request.resource.data.entrega is map
        && request.resource.data.itens is list
        && request.resource.data.itens.size() <= 100
        && request.resource.data.keys().size() <= 20;
    }

    // Confirmação de pagamento por cartão (InfinitePay). Doc por pedido, SEM PII
    // (só status/orderId/forma/parcelas). Leitura PÚBLICA: o comprador anônimo,
    // ao voltar do checkout (#/retorno/<pedido>), precisa ler se saiu 'pago'.
    // ESCRITA negada a qualquer cliente: quem grava é o n8n com Service Account
    // (Admin/REST autenticado), que BYPASSA estas rules — nunca o navegador.
    // O doc de pedido (orders, com PII) continua legível só pela dona.
    match /payments/{orderId} {
      allow read:  if true;
      allow write: if false;
    }

    // COFRE de credenciais de integração (ex.: secrets/superfrete = token Bearer
    // self-service da SuperFrete). NENHUM cliente acessa — nem a dona autenticada
    // (owner-write NEGADO), nem público, nem comprador. Quem grava/lê é SÓ o n8n
    // com Service Account (Admin/REST), que BYPASSA estas rules. O token NUNCA
    // aparece no front nem em config/store (público). A gravação do token pela dona
    // é feita via n8n (browser -> n8n autenticado -> SA -> Firestore), nunca direto.
    // Redundante com o catch-all abaixo, porém EXPLÍCITO de propósito: documenta a
    // intenção e evita que uma edição futura abra o cofre por engano.
    match /secrets/{docId} {
      allow read, write: if false;
    }

    // Tudo o mais: negado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
